{
  "name": "codex-remote-feishu",
  "description": "Template for configuring the Feishu app used by Codex Remote Feishu.",
  "bot": {
    "name": "Codex Remote",
    "menus": [
      {
        "key": "menu",
        "name": "命令菜单",
        "description": "打开私人工作菜单。"
      },
      {
        "key": "stop",
        "name": "停止推理",
        "description": "中断当前执行，并取消此前排队的输入。"
      },
      {
        "key": "steerall",
        "name": "全部加速",
        "description": "当前 Codex 执行支持时，将可追加的待办并入本轮。"
      },
      {
        "key": "new",
        "name": "新建会话",
        "description": "准备一个新会话。"
      },
      {
        "key": "reasoning",
        "name": "推理强度",
        "description": "打开推理强度参数卡。"
      },
      {
        "key": "model",
        "name": "使用模型",
        "description": "打开模型参数卡。"
      },
      {
        "key": "access",
        "name": "执行权限",
        "description": "打开执行权限参数卡。"
      }
    ]
  },
  "message_types": [
    "text",
    "image",
    "file",
    "post"
  ],
  "scopes_import": {
    "scopes": {
      "tenant": [
        "application:application:self_manage",
        "drive:drive",
        "docx:document",
        "wiki:wiki",
        "bitable:app",
        "im:message:readonly",
        "im:message.group_at_msg:readonly",
        "im:message.group_at_msg.include_bot:readonly",
        "im:message.group_msg",
        "im:chat:readonly",
        "im:chat:read",
        "im:chat.members:bot_access",
        "im:chat.members:write_only",
        "im:chat.tabs:read",
        "im:chat.tabs:write_only",
        "im:message.p2p_msg:readonly",
        "im:message.reactions:read",
        "im:message.reactions:write_only",
        "im:message:send_as_bot",
        "im:resource:upload"
      ],
      "user": []
    }
  },
  "event_subscriptions": [
    {
      "event": "im.message.receive_v1",
      "purpose": "接收私聊和项目群的消息，包括回复与附件。"
    },
    {
      "event": "im.message.recalled_v1",
      "purpose": "记录用户撤回的输入及其处理状态。"
    },
    {
      "event": "im.message.reaction.created_v1",
      "purpose": "记录飞书消息反馈。"
    },
    {
      "event": "im.chat.member.bot.added_v1",
      "purpose": "记录机器人加入项目群。"
    },
    {
      "event": "im.chat.member.bot.deleted_v1",
      "purpose": "处理机器人从项目群移除。"
    },
    {
      "event": "im.chat.disbanded_v1",
      "purpose": "处理项目群解散。"
    },
    {
      "event": "application.bot.menu_v6",
      "purpose": "处理工作菜单、项目、资料和执行设置等私人入口。"
    }
  ],
  "callback_subscriptions": [
    {
      "callback": "card.action.trigger",
      "purpose": "处理项目卡片、私人工作导航、设置和待处理请求。"
    }
  ],
  "permissions_checklist": [
    {
      "area": "机器人能力",
      "items": [
        "允许机器人接收用户发送的文本消息",
        "允许机器人接收用户发送的图片消息",
        "允许机器人发送文本消息",
        "允许机器人发送卡片消息",
        "允许机器人添加和移除消息 reaction"
      ]
    },
    {
      "area": "事件订阅",
      "items": [
        "点击“订阅方式”，默认就是“长连接”，点击保存。",
        "开启私聊和项目群消息接收事件",
        "开启消息撤回事件",
        "开启消息 reaction 创建事件",
        "开启机器人进群、退群和群解散事件",
        "开启机器人菜单点击事件"
      ]
    },
    {
      "area": "回调配置",
      "items": [
        "点击“回调订阅方式”，选择“长连接”，点击保存。",
        "确认 card.action.trigger 回调已经配置完成。",
        "当前版本不需要填写 HTTP 回调 URL。"
      ]
    },
    {
      "area": "单聊权限",
      "items": [
        "开通 P2P 消息只读权限。"
      ]
    },
    {
      "area": "项目群与资料权限",
      "items": [
        "开通群信息读取和机器人进退群事件权限。",
        "按需开通自动邀请、群标签页、Docx、知识库和多维表格权限。",
        "给对应机器人授予目标目录或资料的访问权限。"
      ]
    },
    {
      "area": "Markdown 预览权限",
      "items": [
        "开通 drive:drive。",
        "当前实现会实际创建云空间目录、上传文件、查询文件链接，并给目录和文件增加协作者权限。"
      ]
    }
  ],
  "notes": [
    "此文件是项目模板，不保证可直接导入飞书控制台。",
    "请按 deploy/feishu/README.md 的说明，把这里的菜单、事件和权限逐项配置到你的自建应用。",
    "WebSetup 页面里的推荐菜单对应团队运行时的机器人菜单入口。",
    "当前 .md 预览默认上传到应用云空间目录 Codex Remote Previews/，并按会话给用户或群授权。"
  ]
}
